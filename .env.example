# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
 
# OAuth - Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# --- Native (Android) sign-in -------------------------------------------
# Only the Android app uses these. Leave them blank and the app silently
# falls back to the Chrome Custom Tab flow, so nothing breaks while the
# provider consoles are still being set up. See docs/native-oauth-setup.md.
#
# The *Web* client ID from Google Cloud Console -- NOT the Android one.
# Credential Manager requires the web client ID here, and it must match
# GOOGLE_CLIENT_ID above, since that is the audience the backend verifies
# the returned ID token against.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Meta app dashboard -> Settings -> Basic. The App ID is the same value as
# FACEBOOK_APP_ID; the client token is separate (Settings -> Advanced).
# Both ship inside the APK and are not secrets.
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_CLIENT_TOKEN=

