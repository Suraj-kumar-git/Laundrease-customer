# Copy to android/keystore.properties for LOCAL signed release builds.
# That file is gitignored — never commit it, and never commit the .jks itself.
# CI does not use this file; it reads the ANDROID_* env vars instead.
#
# storeFile is resolved relative to android/app/, so an absolute path is safest.
storeFile=/absolute/path/to/laundrease-upload.jks
storePassword=
keyAlias=laundrease
keyPassword=
