<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!-- Deliberately NOT using Theme.SplashScreen as the parent. Android
         12+'s native SplashScreen API always renders whatever icon you give
         it inside its own small, masked icon slot — there is no config that
         makes it show a full rectangular image edge-to-edge with padding,
         that's an OS platform rule. @capacitor/splash-screen's own docs
         document this exact style — parented on AppTheme.NoActionBar
         instead — as how to opt out of that API entirely and use its
         plain, fully custom ImageView-based renderer on every Android
         version, which is what actually lets androidScaleType (see
         capacitor.config.ts) and backgroundColor apply. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>